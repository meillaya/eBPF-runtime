            "prog_cgroup_skb": true,
            "helper_ringbuf_output": true,
            "helper_probe_read_kernel": true
          },
          "degraded_coverage": [
            {
              "feature": "tcx",
              "reason": "TCX introduced in 6.6; not available on 5.15",
              "fallback": "classic TC clsact qdisc (BPF_PROG_TYPE_SCHED_CLS)"
            }
          ],
          "probe_method": "not_tested"
        },
        {
          "kernel": "6.1.0",
          "arch": "x86_64",
          "status": "requires_vm",
          "features": {
            "btf_readable": true,
            "bpf_lsm_active": true,
            "cgroup_v2": true,
            "tcx": false,
            "ring_buffer": true,
            "bpf_lsm_hooks": true,
            "prog_raw_tracepoint": true,
            "prog_kprobe": true,
            "prog_cgroup_skb": true,
            "helper_ringbuf_output": true,
            "helper_probe_read_kernel": true
          },
          "degraded_coverage": [
