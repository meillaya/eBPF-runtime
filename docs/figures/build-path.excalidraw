      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Build time: clang 19 and the host BTF produce the object.\nRun time: libbpf relocates it against the running kernel.",
      "originalText": "Build time: clang 19 and the host BTF produce the object.\nRun time: libbpf relocates it against the running kernel.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 14
    },
    {
      "id": "text-1251",
      "type": "text",
      "x": 30,
      "y": 560,
      "width": 1200,
      "height": 80,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
