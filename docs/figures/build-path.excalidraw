      "roundness": null,
      "seed": 1252,
      "version": 1,
      "versionNonce": 1253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "clang 20 and newer are rejected: their memcpy extern does not\nresolve against the kernel BTF on the tested kernels.",
      "originalText": "clang 20 and newer are rejected: their memcpy extern does not\nresolve against the kernel BTF on the tested kernels.",
