{"description": "Redaction fixture: sensitive fields must be masked before API response", "events": [{"event_id": "evt-clean", "payload": "{\"path\":\"/etc/hostname\",\"comm\":\"cat\"}", "expected_redacted": false, "expected_payload_contains": ["/etc/hostname"]}, {"event_id": "evt-aws-key", "payload": "{\"env\":\"AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE\"}", "expected_redacted": true, "expected_payload_must_not_contain": ["AKIAIOSFODNN7EXAMPLE"]}, {"event_id": "evt-bearer", "payload": "{\"headers\":{\"Authorization\":\"Bearer eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJ1c2VyIn0.sig\"}}", "expected_redacted": true, "expected_payload_must_not_contain": ["eyJhbGciOiJSUzI1NiJ9"]}, {"event_id": "evt-password", "payload": "{\"args\":[\"--password=supersecretpw123\"]}", "expected_redacted": true, "expected_payload_must_not_contain": ["supersecretpw123"]}, {"event_id": "evt-stripe", "payload": "{\"config\":{\"stripe_key\":\"sk_live_abcdefghijklmnopqrst\"}}", "expected_redacted": true, "expected_payload_must_not_contain": ["sk_live_abcdefghijklmnopqrst"]}, {"event_id": "evt-oversized", "payload": "PLACEHOLDER_OVERSIZED", "expected_redacted": true, "note": "payload exceeds 4096 bytes, must be truncated"}], "secret_patterns": ["AKIA[0-9A-Z]{16}", "sk_(live|test)_[0-9A-Za-z]{16,}", "(?i)api[_-]?key[=:]\\s*[0-9A-Za-z._\\-]{16,}", "(?i)bearer\\s+[0-9A-Za-z._\\-]{16,}", "(?i)(password|passwd|token)[=:]\\s*\\S{8,}"]}