{
  "name": "stale-version-rejected",
  "description": "After committing v5, a STAGE with v3 is rejected as stale (monotonic version check).",
  "policy_version": {
    "version": 5,
    "content": "policy-v5",
    "targets": ["spiffe://kernel-v1.test/agent/prod/node-1"]
  },
  "steps": [
    {"action": "stage", "actor": "spiffe://kernel-v1.test/operator/admin", "version": 5},
    {"action": "ready", "agent": "spiffe://kernel-v1.test/agent/prod/node-1", "digest_match": true},
    {"action": "commit", "actor": "spiffe://kernel-v1.test/operator/admin"},
    {"action": "applied", "agent": "spiffe://kernel-v1.test/agent/prod/node-1"},
    {"action": "stage", "actor": "spiffe://kernel-v1.test/operator/admin", "version": 3, "expect_error": "VersionReplay"}
  ],
  "expect": {
    "active_version": 5,
    "stale_rejected": true
  }
}
