{
  "name": "disconnect-maintains-lkg",
  "description": "Agent disconnect at any phase does NOT relax active policy. Last-known-good maintained.",
  "steps": [
    {"action": "stage", "version": 1, "actor": "spiffe://kernel-v1.test/operator/admin"},
    {"action": "ready", "agent": "spiffe://kernel-v1.test/agent/prod/node-1", "digest_match": true},
    {"action": "commit", "actor": "spiffe://kernel-v1.test/operator/admin"},
    {"action": "applied", "agent": "spiffe://kernel-v1.test/agent/prod/node-1"},
    {"action": "disconnect", "agent": "spiffe://kernel-v1.test/agent/prod/node-1"}
  ],
  "expect": {
    "last_known_good_maintained": true,
    "active_policy_not_relaxed": true,
    "agent_state": "Disconnected"
  }
}
