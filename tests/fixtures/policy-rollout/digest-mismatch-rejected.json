{
  "name": "digest-mismatch-rejected",
  "description": "Agent reports wrong digest during READY. Agent transitions to Rejected. Never silent activation.",
  "steps": [
    {"action": "stage", "version": 1, "actor": "spiffe://kernel-v1.test/operator/admin"},
    {"action": "ready", "agent": "spiffe://kernel-v1.test/agent/prod/node-1", "digest_match": false, "computed_digest": "bad-digest"}
  ],
  "expect": {
    "error": "AgentDigestMismatch",
    "agent_state": "Rejected",
    "no_activation": true
  }
}
