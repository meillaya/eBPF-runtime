{
  "name": "partial-rollout-one-rejects",
  "description": "One agent rejects (digest mismatch). Policy remains previous active for that agent. Explicit partial rollout, never silent activation.",
  "policy_version": {
    "version": 1,
    "content": "policy-v1",
    "targets": [
      "spiffe://kernel-v1.test/agent/prod/node-1",
      "spiffe://kernel-v1.test/agent/prod/node-2"
    ]
  },
  "threshold_percent": 50,
  "steps": [
    {"action": "stage", "actor": "spiffe://kernel-v1.test/operator/admin"},
    {"action": "ready", "agent": "spiffe://kernel-v1.test/agent/prod/node-1", "digest_match": true},
    {"action": "ready", "agent": "spiffe://kernel-v1.test/agent/prod/node-2", "digest_match": false},
    {"action": "commit", "actor": "spiffe://kernel-v1.test/operator/admin"},
    {"action": "applied", "agent": "spiffe://kernel-v1.test/agent/prod/node-1"}
  ],
  "expect": {
    "phase": "Partial",
    "active_version": 1,
    "agent_states": {
      "spiffe://kernel-v1.test/agent/prod/node-1": "Applied",
      "spiffe://kernel-v1.test/agent/prod/node-2": "Rejected"
    }
  }
}
