{
  "name": "policy-activation-happy",
  "description": "Happy path: STAGE -> VERIFY -> COMMIT -> APPLIED with matching digest and monotonic version.",
  "steps": [
    { "action": "stage", "version": 1, "content_digest": "digest-v1", "expect_state": "Staged" },
    { "action": "verify", "computed_digest": "digest-v1", "expect_state": "Ready" },
    { "action": "commit", "version": 1, "expect_state": "Applied" }
  ],
  "expect": {
    "final_state": "Applied",
    "monotonic_version": 1
  }
}
