{
  "scenario": "rls_negative_matrix",
  "description": "Row-level security denial cases. RLS is defense-in-depth (service RBAC is primary). These cases verify the database prevents cross-cluster mutations and insufficient-role writes.",
  "cases": [
    {
      "name": "cross_cluster_read",
      "context": {"cluster_id": "cluster-a", "role": "admin", "sub": "admin"},
      "operation": "get_cluster",
      "target_cluster": "cluster-b",
      "expected": "denied",
      "error": "RlsDenied: cross-cluster access"
    },
    {
      "name": "cross_cluster_node_creation",
      "context": {"cluster_id": "cluster-a", "role": "admin", "sub": "admin"},
      "operation": "create_node",
      "target_cluster": "cluster-b",
      "expected": "denied",
      "error": "RlsDenied: cross-cluster access"
    },
    {
      "name": "viewer_policy_write",
      "context": {"cluster_id": null, "role": "viewer", "sub": "viewer-user"},
      "operation": "create_policy",
      "target_cluster": null,
      "expected": "denied",
      "error": "RlsDenied: role 'viewer' not in [policy-admin, admin]"
    },
    {
      "name": "analyst_policy_stage",
      "context": {"cluster_id": null, "role": "analyst", "sub": "analyst-user"},
      "operation": "stage_version",
      "target_cluster": null,
      "expected": "denied",
      "error": "RlsDenied: role 'analyst' not in [policy-admin, admin]"
    }
  ],
  "owner_bypass_risk": {
    "description": "Without RLS context (superuser/owner), all operations succeed. The app role (control_app) has NOBYPASSRLS, so production connections always enforce RLS.",
    "mitigation": "ALTER ROLE control_app NOBYPASSRLS"
  }
}
