{
  "name": "rollback-restores-previous",
  "description": "After commit, rollback reverts to the previous (audit-only) generation",
  "transitions": [
    {"action": "stage", "version": 1, "expect_state": "Staged", "expect_ok": true},
    {"action": "verify", "expect_state": "Ready", "expect_ok": true},
    {"action": "commit", "version": 1, "expect_state": "Applied", "expect_ok": true},
    {"action": "rollback", "expect_state": "Applied", "expect_ok": true}
  ],
  "expect": {
    "final_state": "Applied",
    "active_mode_file_open": "audit",
    "deny_links_pinned": false
  }
}
