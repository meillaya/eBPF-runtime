{
  "name": "commit-before-ready",
  "description": "COMMIT before VERIFY (before Ready) is an invalid transition and must be rejected",
  "transitions": [
    {"action": "stage", "version": 1, "expect_state": "Staged", "expect_ok": true},
    {"action": "commit", "version": 1, "expect_state": "Staged", "expect_ok": false, "expect_error": "InvalidTransition"}
  ],
  "expect": {
    "final_state": "Staged",
    "deny_links_pinned": false
  }
}
