{
  "name": "stale-version-rejected",
  "description": "After committing v5, staging with v3 (stale) is rejected by the monotonic version check",
  "transitions": [
    {"action": "stage", "version": 5, "expect_state": "Staged", "expect_ok": true},
    {"action": "verify", "expect_state": "Ready", "expect_ok": true},
    {"action": "commit", "version": 5, "expect_state": "Applied", "expect_ok": true},
    {"action": "stage", "version": 3, "expect_state": "Applied", "expect_ok": false, "expect_error": "VersionReplay"}
  ],
  "expect": {
    "final_state": "Applied",
    "deny_links_pinned": false
  }
}
