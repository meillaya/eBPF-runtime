{
  "name": "version-replay-rejected",
  "description": "After committing v1, staging with v1 again is a replay and must be rejected",
  "transitions": [
    {"action": "stage", "version": 1, "expect_state": "Staged", "expect_ok": true},
    {"action": "verify", "expect_state": "Ready", "expect_ok": true},
    {"action": "commit", "version": 1, "expect_state": "Applied", "expect_ok": true},
    {"action": "stage", "version": 1, "expect_state": "Applied", "expect_ok": false, "expect_error": "VersionReplay"}
  ],
  "expect": {
    "final_state": "Applied",
    "deny_links_pinned": false
  }
}
