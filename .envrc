# .envrc — kernel-v1 (eBPF Runtime Security & Observability)
#
# direnv integration for the pinned devenv environment declared in
# `devenv.yaml` + `devenv.nix`. We use the explicit, manual form
# (`eval "$(devenv direnvrc)"`) instead of `use devenv` so this works
# on any direnv build without requiring the `use_builtin` extension
# to know about devenv.
#
# Task 2 of .omo/plans/ebpf-runtime-security-observability.md.

if [[ -z "${DIRENV_IN_ENVRC:-}" ]]; then
  # `devenv direnvrc` prints a shell snippet that wires up $PATH, env
  # vars, and shell hooks defined in devenv.nix for the active direnv
  # session. Sourcing it here is what gives `cd .` instant reloads.
  eval "$(devenv direnvrc)"
fi
