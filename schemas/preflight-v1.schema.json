{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernel-v1.local/schemas/preflight/v1.json",
  "title": "kernel-v1 host compatibility preflight (v1)",
  "description": "Read-only host compatibility report emitted by scripts/preflight.sh. Captures kernel identity, BTF availability, LSM/cgroup state, bpffs/tracefs/debugfs mount points, capability state, BPF helper symbols, container runtime, and per-sensor capable|degraded|blocked status. The artifact is non-mutating; the script never invokes sudo, never writes sysctls, never loads kernel modules, and never mounts/unmounts filesystems. Exit codes: 0 capable, 2 degraded, 77 blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "blocked_reason",
    "kernel",
    "features",
    "privilege",
    "container",
    "sensors"
  ],
  "properties": {
    "schema_version": {
      "description": "Bumped on backward-incompatible shape changes. Currently always 1.",
      "const": 1
    },
    "status": {
      "description": "Top-level roll-up. 'capable' iff every sensor is 'capable' AND privilege.can_load is true. 'blocked' iff at least one sensor is 'blocked'. 'degraded' otherwise.",
      "type": "string",
      "enum": ["capable", "degraded", "blocked"]
    },
    "blocked_reason": {
      "description": "Single human-readable reason the run is blocked, or null when the run is not blocked.",
      "type": ["string", "null"]
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "version", "arch", "boot_id", "hostname"],
      "properties": {
        "release":  { "type": "string", "minLength": 1 },
        "version":  { "type": "string", "minLength": 1 },
        "arch":     { "type": "string", "minLength": 1 },
        "boot_id":  { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["btf", "lsm", "cgroup", "mounts", "bpf"],
      "properties": {
        "btf": { "$ref": "#/$defs/btf" },
        "lsm": { "$ref": "#/$defs/lsm" },
        "cgroup": { "$ref": "#/$defs/cgroup" },
        "mounts": { "$ref": "#/$defs/mounts" },
        "bpf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["helpers"],
          "properties": {
            "helpers": { "$ref": "#/$defs/helpers" }
          }
        }
      }
    },
    "privilege": { "$ref": "#/$defs/privilege" },
    "container": { "$ref": "#/$defs/container" },
    "sensors":   { "$ref": "#/$defs/sensors" }
  },
  "$defs": {
    "btf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "readable", "size", "sha256"],
      "properties": {
        "path":     { "type": "string", "minLength": 1 },
        "readable": { "type": "boolean" },
        "size":     { "type": "integer", "minimum": 0 },
        "sha256":   {
          "description": "Lower-case hex SHA-256 of the BTF blob. null when unreadable.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$|^null$"
        }
      }
    },
    "lsm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "bpf_in_list"],
      "properties": {
        "active":      { "type": "string", "minLength": 1 },
        "bpf_in_list": { "type": "boolean" }
      }
    },
    "cgroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "unified_mount", "controllers"],
      "properties": {
        "mode":          { "type": "string", "enum": ["unified", "hybrid", "legacy", "unknown"] },
        "unified_mount": { "type": "string" },
        "controllers":   { "type": "string" }
      }
    },
    "mounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpffs", "tracefs", "debugfs"],
      "properties": {
        "bpffs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "type": "string", "minLength": 1 } }
        },
        "tracefs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "type": "string", "minLength": 1 } }
        },
        "debugfs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "helpers": {
      "description": "Presence of well-known BPF helpers/kfuncs in /proc/kallsyms. The map is keyed by helper name; every value is a boolean.",
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "required": [
        "bpf_probe_read_user",
        "bpf_probe_read_kernel",
        "bpf_ringbuf_output",
        "bpf_map_lookup_elem",
        "bpf_get_current_pid_tgid",
        "bpf_get_current_cgroup_id",
        "bpf_get_ns_current_pid_tgid"
      ],
      "properties": {
        "bpf_probe_read_user":           { "type": "boolean" },
        "bpf_probe_read_kernel":         { "type": "boolean" },
        "bpf_ringbuf_output":            { "type": "boolean" },
        "bpf_map_lookup_elem":           { "type": "boolean" },
        "bpf_get_current_pid_tgid":      { "type": "boolean" },
        "bpf_get_current_cgroup_id":     { "type": "boolean" },
        "bpf_get_ns_current_pid_tgid":   { "type": "boolean" }
      }
    },
    "privilege": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective", "bounding", "can_load", "unprivileged_bpf_disabled"],
      "properties": {
        "effective": {
          "description": "CapEff rendered as 0x... hex (always 16 hex digits).",
          "type": "string",
          "pattern": "^0x[0-9a-f]{16}$"
        },
        "bounding": {
          "description": "CapBnd rendered as 0x... hex (always 16 hex digits).",
          "type": "string",
          "pattern": "^0x[0-9a-f]{16}$"
        },
        "can_load": {
          "description": "True iff CapEff has CAP_BPF + CAP_PERFMON AND unprivileged_bpf_disabled is 0.",
          "type": "boolean"
        },
        "unprivileged_bpf_disabled": {
          "description": "0 = unprivileged BPF allowed, 1 = temporarily disabled, 2 = permanently disabled.",
          "type": "integer",
          "enum": [0, 1, 2]
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "in_container"],
      "properties": {
        "runtime":      { "type": "string", "enum": ["host", "docker", "containerd", "cri-o", "podman", "unknown"] },
        "in_container": { "type": "boolean" }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "type": "string", "enum": ["capable", "degraded", "blocked"] },
        "reason": {
          "description": "Stable token describing the failure (e.g. 'no-cap-bpf-or-perfmon', 'btf-unreadable', 'lsm-bpf-not-in-list', 'cgroup-not-unified', 'helper-missing:<name>'). null when status == 'capable'.",
          "type": ["string", "null"]
        }
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process.bpf",
        "file.bpf",
        "network.bpf",
        "dns.bpf",
        "syscall.bpf",
        "lsm.bpf",
        "identity.bpf",
        "ringbuf.bpf",
        "loader"
      ],
      "properties": {
        "process.bpf":  { "$ref": "#/$defs/sensor" },
        "file.bpf":     { "$ref": "#/$defs/sensor" },
        "network.bpf":  { "$ref": "#/$defs/sensor" },
        "dns.bpf":      { "$ref": "#/$defs/sensor" },
        "syscall.bpf":  { "$ref": "#/$defs/sensor" },
        "lsm.bpf":      { "$ref": "#/$defs/sensor" },
        "identity.bpf": { "$ref": "#/$defs/sensor" },
        "ringbuf.bpf":  { "$ref": "#/$defs/sensor" },
        "loader":       { "$ref": "#/$defs/sensor" }
      }
    }
  }
}
