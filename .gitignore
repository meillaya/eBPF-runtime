# Build artifacts
/target/
**/target/

# cargo-fuzz harness artifacts (per-crate fuzz/ crates; corpora are local-only).
# fuzz/target/ is already covered by **/target/ above.
**/fuzz/corpus/
**/fuzz/artifacts/
**/fuzz/Cargo.lock

# devenv / direnv / preflight caches
.devenv/
.direnv/
.preflight/

# start-work / boulder artifacts (task 1+ workflow scratch)
/.omo/start-work/
/.omo/boulder.json

# Prometheus orchestration session bookkeeping (ephemeral, not part of the workspace)
/.omo/run-continuation/

# Nix `nix build` / `nix run` symlink outputs
result
result-*

# Editor / IDE / OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Web build outputs (UI package)
/web/node_modules/
/web/dist/

# codegraph cache symlink (per-host, not part of the workspace)
/.codegraph

# Generated proto / OpenAPI clients (wave 5/web fills these in)
target/
**/target/
# Buf-generated artifacts (regenerated from source proto files)
crates/protocol/src/generated/
web/src/generated/
**/generated.rs
**/generated.ts
**/*.pb.ts
**/*.pb.rs
# Task 9 exception: crates/event-abi/src/generated.rs is the
# hand-written Rust mirror of bpf/include/event_abi.h. The build
# script records its SHA-256 in the manifest; tests/manifest.rs
# rejects drift. NOT a proto-buf-generated artifact.
!crates/event-abi/src/generated.rs

# libbpf-cargo build artifacts (regenerated from bpf/sensors/*.bpf.c)
target/bpf-out/
target/bpf-build.manifest.json
# task 9 emits a parallel event-abi manifest under target/. task 10
# regenerates it during the bpf:build pipeline (bpf-build's build.rs
# reads event-abi's manifest to cross-check the C ABI version). It
# MUST NOT be committed; the bpf-build manifest is the source of
# truth for the CO-RE pipeline.
target/event-abi.manifest.json

# Release OCI scaffolding artifacts (regenerated from source by release-verify.sh)
release/out/
release/out/**/*.tar*
release/cosign/
release/sbom/
release/.key/bpf/sensors/*.bpf.o
bpf/sensors/vmlinux.h
