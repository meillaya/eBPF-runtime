# SPDX-License-Identifier: Apache-2.0 OR MIT
# deploy/oci/Dockerfile.agent — multi-stage OCI build for the kernel-v1 node agent.
#
# Build via Docker Bake (preferred):
#   docker buildx bake -f deploy/oci/docker-bake.hcl agent
#
# Or directly (single-arch):
#   docker buildx build \
#     --platform linux/amd64 \
#     -f deploy/oci/Dockerfile.agent \
#     --tag ghcr.io/kernel-v1/agent:dev \
#     --output type=oci,dest=/tmp/agent.oci \
#     .
#
# Stages:
#   1. bpf-compile  — compile CO-RE BPF objects from bpf/sensors/*.bpf.c
#   2. rust-build   — compile the agent binary (glibc-linked, no musl needed)
#   3. runtime      — distroless/cc-debian12, binary + BPF objects only
#
# Runtime image contains: NO compiler, NO source code, NO test fixtures,
# NO dev tools. Only the agent binary and pre-compiled BPF objects.
#
# syntax=docker/dockerfile:1.7

# ----- Pinned base image digests (overridable via --build-arg) -----
# Resolved from deploy/oci/base-images.json. Update with:
#   docker buildx imagetools inspect <image>:<tag>
ARG RUST_BUILDER_AMD64=docker.io/library/rust:1.95-slim@sha256:28846ec5a6bcfcddb93f403ba7071bd579787852b2f2ac3839965620e8bd9456
ARG RUST_BUILDER_ARM64=docker.io/library/rust:1.95-slim@sha256:039d198bab66a591902cafa2133bf7dce22dc51606fb200d7eac51e112d3c5da
ARG RUNTIME_AMD64=gcr.io/distroless/cc-debian12@sha256:edadc10b499999450d604293efc91f592e7521a4746d910702fbfe2efbe6db4f
ARG RUNTIME_ARM64=gcr.io/distroless/cc-debian12@sha256:d13e394443887d968fa82b77b2dc39beb7918812ab21c33f1e989994fb7f6723

# =====================================================================
# Stage 1: BPF object compilation (runs on BUILDPLATFORM, native speed)
# =====================================================================
FROM --platform=$BUILDPLATFORM ${RUST_BUILDER_AMD64} AS bpf-compile

RUN apt-get update && apt-get install -y --no-install-recommends \
      clang \
      llvm \
      libbpf-dev \
      bpftool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only BPF sources (layer-cached independently of Rust code).
COPY bpf/sensors/ bpf/sensors/
COPY bpf/include/ bpf/include/

# Compile BPF objects for the target architecture.
# BPF bytecode is host-independent; -D__TARGET_ARCH_* selects the
# CO-RE relocations for the target kernel.
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) BPF_ARCH_MACRO=x86  ;; \
      arm64) BPF_ARCH_MACRO=arm64 ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out/bpf; \
    for src in bpf/sensors/*.bpf.c; do \
      stem="$(basename "$src" .bpf.c)"; \
      clang -O2 -g -Wall -target bpf \
        -D__TARGET_ARCH_${BPF_ARCH_MACRO} \
        -I bpf/include \
        -I bpf/sensors \
        -c "$src" \
        -o "/out/bpf/${stem}.${TARGETARCH}.bpf.o"; \
    done; \
    ls -la /out/bpf/

# =====================================================================
# Stage 2: Rust binary compilation (runs on BUILDPLATFORM, cross-links)
# =====================================================================
FROM --platform=$BUILDPLATFORM ${RUST_BUILDER_AMD64} AS rust-build

# Cross-compilation toolchain for arm64 targets.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc-aarch64-linux-gnu \
      g++-aarch64-linux-gnu \
      pkg-config \
      libelf-dev \
    && rm -rf /var/lib/apt/lists/*

# Add the cross-compilation Rust target.
RUN rustup target add aarch64-unknown-linux-gnu

# Configure cargo to use the cross-linker for aarch64.
RUN mkdir -p /root/.cargo && \
    printf '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"\n' \
      > /root/.cargo/config.toml

WORKDIR /build

# Copy workspace manifests first for dependency layer caching.
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

# Build the agent binary for the target architecture.
# The bpf-build build.rs requires /sys/kernel/btf/vmlinux which is
# unavailable in unprivileged builds; set BPF_BUILD_SKIP=1 to bypass
# BPF compilation in build.rs (BPF objects come from stage 1).
ARG TARGETARCH
ENV BPF_BUILD_SKIP=1
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) RUST_TARGET=x86_64-unknown-linux-gnu ;; \
      arm64) RUST_TARGET=aarch64-unknown-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    cargo build --release --target "$RUST_TARGET" -p agent; \
    mkdir -p /out; \
    cp "target/${RUST_TARGET}/release/agent" /out/kernel-v1-agent; \
    chmod 0755 /out/kernel-v1-agent

# =====================================================================
# Stage 3: Runtime (distroless — no shell, no package manager)
# =====================================================================
# Platform-conditional FROM: select the right runtime digest.
FROM ${RUNTIME_AMD64} AS runtime-amd64
FROM ${RUNTIME_ARM64} AS runtime-arm64

# Final stage aliases the correct platform runtime.
FROM runtime-${TARGETARCH} AS runtime

# Agent binary only — no compiler, no source, no test fixtures.
COPY --from=rust-build /out/kernel-v1-agent /usr/local/bin/kernel-v1-agent

# Pre-compiled CO-RE BPF objects (architecture-specific).
COPY --from=bpf-compile /out/bpf/ /opt/kernel-v1/bpf/

# Run as nonroot (UID 65532, distroless default nonroot user).
USER 65532:65532

# Prometheus metrics scrape endpoint.
EXPOSE 9464

ENTRYPOINT ["/usr/local/bin/kernel-v1-agent"]
